+            case GLX_ALPHA_SIZE: case GLX_DEPTH_SIZE: case GLX_STENCIL_SIZE:
+            case GLX_ACCUM_RED_SIZE: case GLX_ACCUM_GREEN_SIZE:
+            case GLX_ACCUM_BLUE_SIZE: case GLX_ACCUM_ALPHA_SIZE:
